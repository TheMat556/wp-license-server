msgstr ""

#: app/Plugin.php:200
msgid "Welcome to WP License Server — Encryption Key Setup"
msgstr "Willkommen bei WP License Server – Einrichtung des Verschlüsselungsschlüssels"

#: app/Plugin.php:203
msgid "This plugin needs an encryption key to secure your license data. Would you like the system to generate one and add it to your wp-config.php file automatically?"
msgstr "Dieses Plugin benötigt einen Verschlüsselungsschlüssel, um Ihre Lizenzdaten zu schützen. Möchten Sie, dass das System einen generiert und automatisch zu Ihrer wp-config.php-Datei hinzufügt?"

#: app/Plugin.php:209
msgid "Yes, generate and secure my key"
msgstr "Ja, Schlüssel generieren und sichern"

#: app/Plugin.php:214
msgid "No, I'll do it manually"
msgstr "Nein, ich mache es manuell"

#: app/Plugin.php:218
msgid "If you choose \"No\", the plugin will not be able to boot until WPLICENSE_ENCRYPTION_KEY is defined in your wp-config.php."
msgstr ""

#: app/Plugin.php:227
#: app/Plugin.php:259
#: app/Plugin.php:344
msgid "Unauthorized"
msgstr "Nicht autorisiert"

#: app/Plugin.php:287
msgid "Encryption key added to wp-config.php successfully. This notice will disappear on the next page load."
msgstr "Verschlüsselungsschlüssel erfolgreich zur wp-config.php hinzugefügt. Dieser Hinweis verschwindet beim nächsten Seitenaufruf."

#: app/Plugin.php:293
msgid "wp-config.php is not writable by the web server. Please add the line manually."
msgstr "wp-config.php ist für den Webserver nicht beschreibbar. Bitte fügen Sie die Zeile manuell hinzu."

#: app/Plugin.php:294
msgid "Could not read wp-config.php. Please add the line manually."
msgstr "Konnte wp-config.php nicht lesen. Bitte fügen Sie die Zeile manuell hinzu."

#: app/Plugin.php:295
msgid "Could not write to wp-config.php. Please add the line manually."
msgstr "Konnte nicht in wp-config.php schreiben. Bitte fügen Sie die Zeile manuell hinzu."

#: app/Plugin.php:296
msgid "Could not find the right location in wp-config.php. Please add the line manually."
msgstr "Konnte die richtige Position in wp-config.php nicht finden. Bitte fügen Sie die Zeile manuell hinzu."

#: app/Plugin.php:297
msgid "Could not create wp-config.php backup. Aborted to protect your site. Please add the line manually."
msgstr "Konnte kein Backup der wp-config.php erstellen. Zum Schutz Ihrer Website abgebrochen. Bitte fügen Sie die Zeile manuell hinzu."

#: app/Plugin.php:298
msgid "Stored encryption key contains unexpected characters. Aborted to avoid corrupting wp-config.php."
msgstr "Gespeicherter Verschlüsselungsschlüssel enthält unerwartete Zeichen. Zum Schutz der wp-config.php abgebrochen."

#: app/Plugin.php:299
msgid "wp-config.php directory is not writable for atomic replace. Please add the line manually."
msgstr "wp-config.php-Verzeichnis ist für atomares Ersetzen nicht beschreibbar. Bitte fügen Sie die Zeile manuell hinzu."

#: app/Plugin.php:323
msgid "WP License Server — Encryption Key Setup"
msgstr "WP License Server – Einrichtung des Verschlüsselungsschlüssels"

#: app/Plugin.php:324
msgid "Your encryption key is currently stored in the database. For production security, move it to wp-config.php."
msgstr "Ihr Verschlüsselungsschlüssel wird derzeit in der Datenbank gespeichert. Verschieben Sie ihn aus Sicherheitsgründen in die wp-config.php."

#: app/Plugin.php:327
msgid "Copy Key to Clipboard"
msgstr "Schlüssel in Zwischenablage kopieren"

#: app/Plugin.php:328
msgid "Then add"
msgstr "Dann fügen Sie"

#: app/Plugin.php:328
msgid "to wp-config.php"
msgstr "zur wp-config.php hinzu"

#: app/Plugin.php:330
msgid "The database key will continue to be used as a fallback until then."
msgstr "Der Datenbankschlüssel wird bis dahin weiterhin als Fallback verwendet."

#: app/Plugin.php:334
msgid "Auto-add to wp-config.php"
msgstr "Automatisch zur wp-config.php hinzufügen"

#: app/Plugin.php:335
msgid "WordPress will insert the line before the \"stop editing\" comment."
msgstr ""

