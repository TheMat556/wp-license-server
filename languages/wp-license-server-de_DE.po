#: app/Rest/Controllers/AdminLicensesController.php:108
#: app/Rest/Controllers/AdminLicensesController.php:130
msgid "A valid license ID is required."
msgstr "Eine gültige Lizenz-ID ist erforderlich."

#: app/Rest/Controllers/AdminLicensesController.php:116
msgid "The license could not be deleted."
msgstr "Die Lizenz konnte nicht gelöscht werden."

#: app/Services/EncryptionService.php:117
msgid "The encryption key is stored in wp_options (database). For stronger security, define WPLICENSE_ENCRYPTION_KEY as a constant in wp-config.php or set it via a server-side environment variable so the key is never stored alongside the data it protects."
msgstr "Der Verschlüsselungsschlüssel wird in wp_options (Datenbank) gespeichert. Definieren Sie aus Sicherheitsgründen WPLICENSE_ENCRYPTION_KEY als Konstante in wp-config.php oder als serverseitige Umgebungsvariable, damit der Schlüssel niemals zusammen mit den geschützten Daten gespeichert wird."

#: app/Services/EncryptionService.php:119
msgid "Dismiss for 30 days"
msgstr "Für 30 Tage ausblenden"

#: app/Services/EncryptionService.php:162
msgid "WPLICENSE_ENCRYPTION_KEY constant is required in production. Define it in wp-config.php, or set the wplicense_allow_db_encryption_key filter to true to accept the database fallback."
msgstr "Die Konstante WPLICENSE_ENCRYPTION_KEY wird in der Produktion benötigt. Definieren Sie sie in wp-config.php oder setzen Sie den Filter wplicense_allow_db_encryption_key auf true, um den Datenbank-Fallback zu akzeptieren."

#: app/Services/EncryptionService.php:171
msgid "WPLICENSE_ENCRYPTION_KEY constant is required."
msgstr "Die Konstante WPLICENSE_ENCRYPTION_KEY wird benötigt."

#. translators: %d: number of bytes required
#: app/Services/EncryptionService.php:184
#, php-format
msgid "Encryption key must be exactly %d bytes, base64-encoded."
msgstr "Der Verschlüsselungsschlüssel muss genau %d Byte lang und base64-kodiert sein."

#: app/Services/EncryptionService.php:217
msgid "Invalid ciphertext encoding."
msgstr "Ungültige Chiffrat-Kodierung."

#. translators: %d: encryption version number
#: app/Services/EncryptionService.php:226
#, php-format
msgid "Unknown encryption version: %d."
msgstr "Unbekannte Verschlüsselungsversion: %d."

#: app/Services/EncryptionService.php:237
msgid "Decryption failed — wrong key or corrupted data."
msgstr "Entschlüsselung fehlgeschlagen – falscher Schlüssel oder beschädigte Daten."

