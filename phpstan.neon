parameters:
    level: 6
    paths:
        - app
    excludePaths:
        - vendor
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    treatPhpDocTypesAsCertain: false
    dynamicConstantNames:
        - WP_LICENSE_SERVER_FILE
        - WP_LICENSE_SERVER_PATH
        - WP_LICENSE_SERVER_BASENAME
        - WP_LICENSE_SERVER_VERSION
        - WP_LICENSE_SERVER_DB_VERSION
    ignoreErrors:
        # WP-CLI is an optional runtime dependency — stubs not required
        - '#Call to static method (error|success|log|warning)\(\) on an unknown class WP_CLI#'
        - '#Instantiated class WP_CLI\\Formatter not found#'
        - '#Call to method display_items\(\) on an unknown class WP_CLI\\Formatter#'
        - '#Function WP_CLI\\Utils\\get_flag_value not found#'
        # Plugin constants defined in the main plugin file at runtime
        - '#Constant WP_LICENSE_SERVER_FILE not found#'
        - '#Constant WP_LICENSE_SERVER_PATH not found#'
        - '#Constant WP_LICENSE_SERVER_BASENAME not found#'
        - '#Constant WP_LICENSE_SERVER_VERSION not found#'
        - '#Constant WP_LICENSE_SERVER_DB_VERSION not found#'
        # WP_React_UI_Asset_Loader is an optional runtime dependency
        - '#Call to function method_exists\(\) with .WP_React_UI_Asset.*. and .get_preload_assets. will always evaluate to false#'
