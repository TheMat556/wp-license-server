# ============================================================
# WP License Server — Environment / wp-config.php constants
# Copy this file to .env or add the constants to wp-config.php.
# Never commit real values to version control.
# ============================================================

# -----------------------------------------------------------------
# REQUIRED: 32-byte encryption key for license keys at rest.
# Generate with: php -r "echo base64_encode(random_bytes(32));"
# Must be a base64-encoded string that decodes to exactly 32 bytes.
# -----------------------------------------------------------------
WPLICENSE_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# -----------------------------------------------------------------
# WordPress database credentials (standard wp-config.php constants)
# -----------------------------------------------------------------
DB_NAME=wordpress
DB_USER=root
DB_PASSWORD=secret
DB_HOST=localhost
DB_CHARSET=utf8mb4
DB_COLLATE=

# -----------------------------------------------------------------
# WordPress table prefix
# -----------------------------------------------------------------
table_prefix=wp_

# -----------------------------------------------------------------
# WordPress environment flags
# -----------------------------------------------------------------
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false

# -----------------------------------------------------------------
# WordPress site URLs
# -----------------------------------------------------------------
WP_HOME=https://example.com
WP_SITEURL=https://example.com

# -----------------------------------------------------------------
# Optional: Webhook HMAC secret used for outbound webhook payloads.
# If unset, a per-request secret is derived from the license key.
# -----------------------------------------------------------------
# WPLICENSE_WEBHOOK_SECRET=your-webhook-signing-secret

# -----------------------------------------------------------------
# Optional: Disable the automatic key rotation scheduler.
# Set to true only in development/test environments.
# -----------------------------------------------------------------
# WPLICENSE_DISABLE_KEY_ROTATION=false
